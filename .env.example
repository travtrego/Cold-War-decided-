# Copy these values into Vercel Project Settings → Environment Variables.
# Never commit a real API key or access code.
OPENAI_API_KEY=replace-with-your-openai-api-key
LIVE_AI_ACCESS_CODE=replace-with-a-long-random-private-passphrase
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql://server-only-connection-string
